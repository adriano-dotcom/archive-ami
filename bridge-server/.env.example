# Bridge Server — WhatsApp Calling

# Port to listen on (Railway sets this automatically)
PORT=3001

# Secret shared between this server and the whatsapp-call-webhook edge function.
# The webhook sends this in the X-Bridge-Secret header on every POST /incoming-call.
BRIDGE_SECRET=troque-por-um-segredo-aleatorio-forte

# Supabase project URL (e.g. https://bbllbsbcogngjfrhhggq.supabase.co)
SUPABASE_URL=https://SEU_PROJETO.supabase.co

# Supabase service role key — used to call edge functions server-to-server
SUPABASE_SERVICE_ROLE_KEY=eyJhbGci...sua-service-role-key
